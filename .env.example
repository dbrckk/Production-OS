# Production-OS deployment defaults
# Copy to .env and fill secrets locally. Never commit the populated .env.

# Server-side token used only to dispatch the ai-dev-server GitHub Actions worker.
GITHUB_TOKEN=

PRODUCTION_OS_GITHUB_OWNER=dbrckk
PRODUCTION_OS_ACTIONS_REPOSITORY=dbrckk/ai-dev-server
PRODUCTION_OS_ACTIONS_WORKFLOW=production-os-actions-worker.yml
PRODUCTION_OS_ACTIONS_REF=main

# SQLite backups live on the same persistent /data mount by default.
PRODUCTION_OS_BACKUP_DIR=/data/backups

# Optional trust / webhook configuration.
PRODUCTION_OS_GITHUB_WEBHOOK_SECRET=
PRODUCTION_OS_VALIDATION_ATTESTATION_KEYS={}
PRODUCTION_OS_VALIDATION_PUBLIC_KEYS={}
PRODUCTION_OS_RELEASE_PROVENANCE_SECRET=
PRODUCTION_OS_RELEASE_PROVENANCE_PRIVATE_KEY=
PRODUCTION_OS_RELEASE_PROVENANCE_PUBLIC_KEY=
