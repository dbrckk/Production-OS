FROM instrumentisto/flutter:3.41.6-androidsdk36-r0

USER root
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md LICENSE ./
COPY src ./src

RUN python3 -m venv /opt/production-os-venv \
    && /opt/production-os-venv/bin/pip install --no-cache-dir ".[postgres]"

ENV PATH="/opt/production-os-venv/bin:${PATH}"
ENV ANDROID_AVD_HOME=/opt/android-avd
ENV PRODUCTION_OS_ANDROID_AVD=production-os-api35

RUN mkdir -p "${ANDROID_AVD_HOME}" \
    && yes | sdkmanager --licenses >/dev/null \
    && sdkmanager \
       "platform-tools" \
       "emulator" \
       "platforms;android-35" \
       "build-tools;35.0.0" \
       "system-images;android-35;google_apis;x86_64" \
    && echo no | avdmanager create avd \
       --force \
       --name "${PRODUCTION_OS_ANDROID_AVD}" \
       --package "system-images;android-35;google_apis;x86_64" \
       --device "pixel_6" \
    && chmod -R a+rwX "${ANDROID_AVD_HOME}"

ENTRYPOINT ["production-os"]
CMD ["remote-worker-run","--help"]
